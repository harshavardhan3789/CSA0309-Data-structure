#include <stdio.h>

#define MAX 20
#define INF 99999

int main() {
    int graph[MAX][MAX];
    int distance[MAX], visited[MAX];
    int n, source;
    int i, j, count, min, next;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost adjacency matrix:\n");
    printf("Enter 0 for no edge.\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter source vertex: ");
    scanf("%d", &source);

    for (i = 0; i < n; i++) {
        distance[i] = INF;
        visited[i] = 0;
    }

    distance[source] = 0;

    for (count = 0; count < n - 1; count++) {
        min = INF;
        next = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                next = i;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && graph[next][i] != 0 &&
                distance[next] + graph[next][i] < distance[i]) {

                distance[i] = distance[next] + graph[next][i];
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n", source);

    for (i = 0; i < n; i++)
        printf("To %d = %d\n", i, distance[i]);

    return 0;
}
