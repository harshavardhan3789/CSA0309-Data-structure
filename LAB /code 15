#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void initialize() {
    int i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

void insert(int key) {
    int index, i;

    index = key % SIZE;

    for (i = 0; i < SIZE; i++) {
        int pos = (index + i) % SIZE;

        if (hashTable[pos] == -1) {
            hashTable[pos] = key;
            return;
        }
    }

    printf("Hash table is full.\n");
}

void display() {
    int i;

    for (i = 0; i < SIZE; i++)
        printf("%d : %d\n", i, hashTable[i]);
}

int main() {
    int n, key, i;

    initialize();

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");

    for (i = 0; i < n; i++) {
        scanf("%d", &key);
        insert(key);
    }

    printf("\nHash Table:\n");
    display();

    return 0;
}
